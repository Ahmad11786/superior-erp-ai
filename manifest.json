{
  "manifest_version": 3,
  "name": "Superior ERP AI Feedback Assistant",
  "version": "1.1.0",
  "description": "Assists with feedback forms in the authenticated Superior University ERP session.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://erp.superior.edu.pk/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Superior ERP AI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.superior.edu.pk/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/logger.js",
        "content/erp-detector.js",
        "content/list-scanner.js",
        "content/form-reader.js",
        "content/form-filler.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}